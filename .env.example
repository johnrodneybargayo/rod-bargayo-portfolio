# Copy into Vercel > Project > Settings > Environment Variables.
# For local development, copy this file to .env.local. Never commit real values.

# ---- Brevo (recommended, free plan: 300 emails/day) ----
# API key: Brevo > SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY=
# A sender address verified in Brevo (Senders, Domains & Dedicated IPs)
MAIL_FROM=hello@yourdomain.com
# Your inbox, where form messages arrive (can be Gmail)
MAIL_TO=you@example.com
FROM_NAME=Rod Bargayo Portfolio
# Brevo list for campaigns: Contacts > Lists, use the list's ID number.
# Visitors who tick "Send me occasional updates" are added here.
# Several lists: 2,7
BREVO_LIST_ID=

# ---- Hostinger Email over SMTP (optional fallback) ----
# Used only when BREVO_API_KEY is empty.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
