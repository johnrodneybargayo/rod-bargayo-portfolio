# Copy into Vercel > Project > Settings > Environment Variables.
# For local development, copy this file to .env.local. Never commit real values.

# Hostinger mailbox (hPanel > Emails). Required.
SMTP_USER=hello@yourdomain.com
SMTP_PASS=your-mailbox-password

# Where messages are delivered. Leave empty to deliver into SMTP_USER's inbox.
MAIL_TO=

# Defaults shown; only change if Hostinger tells you otherwise.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
FROM_NAME=Rod Bargayo Portfolio
